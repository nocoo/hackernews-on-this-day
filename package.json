{
  "name": "hackernews-on-this-day",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --config vite.server.config.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings . && bun run scripts/quality/check-tests.ts",
    "check": "bun run lint && bun run typecheck",
    "workflow:lint": "bun run scripts/quality/check-workflows.ts",
    "hooks:install": "bash scripts/quality/install-hooks.sh",
    "test": "bun run build && vitest run tests",
    "test:coverage": "vitest run tests/calendar.test.ts tests/quality.test.ts tests/archive.test.ts --coverage",
    "test:deployment": "node --test scripts/verify-deployment.test.mjs scripts/release-proof.test.mjs && python3 tests/verify_remote_test.py",
    "test:integration": "bun run build && vitest run tests/archive.test.ts tests/production.test.ts",
    "test:browser": "bun run build && playwright test",
    "test:container": "bun run scripts/container-smoke.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^4.1.0"
  }
}
